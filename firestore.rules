rules_version = '2';

// ============================================================================
//  Together For Health — Firestore security rules
// ============================================================================
//  This file is the actual access control for the club's data. It runs on
//  Google's servers and the client cannot change it, which is the whole point
//  of moving off the GitHub Gist: before this, "approved" was a flag inside a
//  blob the browser owned, so any member could edit their own status, and the
//  entire database was readable by anyone with no credentials at all.
//
//  Paste this into: Firebase console -> Firestore Database -> Rules -> Publish
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers -----------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    // EMERGENCY BOOTSTRAP AND RECOVERY ONLY. Needed because the very first sign-in
    // happens when no user document exists, so nobody could otherwise be an admin and
    // approve the first person. Checked against the Google-issued, verified token — not
    // against anything the client sends.
    //
    // Succession does NOT run through this list: once anyone is an admin, the next
    // president is made one by approving them with permissionTier 'admin'. Keep this to
    // the CLUB-OWNED Google account, so recovery access does not leave with a graduating
    // student. Must match OWNER_EMAILS in firebase-sync.js.
    function isOwner() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'togetherforhealthmdhs@gmail.com',   // club-owned: keep permanently
             'golussaud@gmail.com'                // personal: remove once the club account is verified
           ];
    }

    function myDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myDocExists() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isApproved() {
      return isOwner() || (myDocExists() && myDoc().status == 'approved');
    }

    function isStaff() {
      return isOwner() || (myDocExists()
        && myDoc().status == 'approved'
        && myDoc().permissionTier in ['admin', 'officer']);
    }

    // ---- users -------------------------------------------------------------
    //
    //  One document per person, keyed by their Firebase Auth uid. A member can
    //  always read their own record — that is what makes instant approval work
    //  without exposing any club data to someone not yet approved.

    match /users/{uid} {

      allow get: if signedIn() && (request.auth.uid == uid || isStaff());

      // Only staff can enumerate the roster. A member listing all users would
      // be a directory of every student's name, email and grade.
      allow list: if isStaff();

      // You may create only your own record, only as 'pending', only with your
      // own verified email, and only as an ordinary member. This is what makes
      // self-approval impossible rather than merely discouraged.
      //
      // NOTE: this restriction deliberately applies to the OWNER's first write too, so
      // there is no owner exemption here. firebase-sync.js bootstraps the owner in two
      // steps instead — create within these limits, then elevate via update (which
      // isStaff/isOwner does permit). Do not "fix" this by adding isOwner() to the create
      // rule: that would weaken the one rule that makes privilege escalation impossible,
      // for the sake of a once-ever operation that already works.
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'pending'
        && request.resource.data.permissionTier == 'member'
        && request.resource.data.roleId == 'role_member';

      // Staff may change anything. A member may edit their own profile fields
      // but can never touch the three fields that grant access.
      allow update: if isStaff()
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.status == resource.data.status
            && request.resource.data.permissionTier == resource.data.permissionTier
            && request.resource.data.roleId == resource.data.roleId
            && request.resource.data.email == resource.data.email);

      allow delete: if isStaff();
    }

    // ---- club data ---------------------------------------------------------
    //
    //  Split in two, because the app's 30-permission role system is UI gating that these
    //  rules cannot see. With a single document, "approved member" was the only distinction
    //  available, so any member could technically rewrite the budget, the roster or the
    //  whole calendar. The split gives the rules something real to enforce.

    //  Staff-owned: events, meetings, roster, budget, resources, outreach, plans, goals.
    //  Every approved member reads it; only admins and officers write it.
    match /club/state {
      allow read:  if isApproved();
      allow write: if isStaff();
    }

    //  Member-owned: ideas, feedback, hours and shift claims — the four things a member
    //  legitimately creates for themselves. Shift claims live here rather than inside the
    //  event object precisely so that events can stay staff-only while sign-ups stay open.
    //
    //  Known limitation, stated rather than hidden: this is still one document, so a member
    //  can technically edit another member's hours entry or delete someone's idea. Ending
    //  that needs per-record documents (hours/{uid}/entries/{id}). It is a much smaller
    //  exposure than the budget, and it is confined to approved club members.
    match /club/open {
      allow read:  if isApproved();
      allow write: if isApproved();
    }

    //  Anything else under club/ is not part of the schema.
    match /club/{other} {
      allow read:  if isApproved();
      allow write: if isStaff();
    }

    // ---- default deny ------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
